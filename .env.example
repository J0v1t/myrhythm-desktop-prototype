# Local database default. Leave unset to use instance/myrhythm.db.
# DATABASE_URL=sqlite:///C:/absolute/path/to/myrhythm.db

# Supabase Auth. Use the project base URL or the REST URL; the app normalizes it.
# This must be a publishable key only. Never put service-role keys in the client.
SUPABASE_URL=https://yyjlkqvrjabcuuugpvyg.supabase.co/rest/v1/
SUPABASE_PUBLIC_KEY=replace-with-your-supabase-publishable-key

# Optional local assets. Do not commit the referenced files.
MYRHYTHM_MUSIC_DIR=C:/path/to/licensed/music
MYRHYTHM_SONG_MANIFEST=C:/path/to/song_manifest.csv
MYRHYTHM_SAMPLE_AUDIO=C:/path/to/licensed/sample.mp3
MYRHYTHM_FER_MODEL_PATH=C:/path/to/models/myrhythm_fer.h5
MYRHYTHM_HR_MODEL_PATH=C:/path/to/models/lstm_model.keras
MYRHYTHM_HR_LABEL_ENCODER_PATH=C:/path/to/models/label_encoder.pkl

# Future cloud/backend settings. Desktop clients must not contain service-role
# keys, object-storage secrets, or raw database passwords.
# MYRHYTHM_API_BASE_URL=http://127.0.0.1:8000
MYRHYTHM_ASSET_API_BASE_URL=https://myrhythm-assets-api.zctrl7801.workers.dev
