# The reviewer experience needs no .env file. These are optional overrides for
# maintainers testing another Supabase project or Cloudflare Worker.
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLIC_KEY=your-publishable-key
# MYRHYTHM_ASSET_API_BASE_URL=https://your-worker.workers.dev
#
# Never put service-role keys, R2 credentials, database passwords, or
# Cloudflare API tokens in this file or in the desktop client.
