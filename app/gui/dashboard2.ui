             <property name="styleSheet">
              <string notr="true">QSlider::groove:horizontal {
    background: #282828;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #FFFFFF;
    height: 4px;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: #606060;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #F0F0F0;
    width: 14px;
    height: 14px;
    margin: -6px 0;
}</string>
