               <item>
                <widget class="QScrollArea" name="scrollArea">
                 <property name="styleSheet">
                  <string notr="true">QScrollArea {
    /* Ensures the scroll area itself is frameless */
    border: none;
    background-color: transparent;
}

/* 1. Base Scroll Bar Styling (The main vertical bar) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    /* Make the entire area where the scrollbar sits very narrow */
    width: 8px; 
    /* The arrows aren't typically used in this style, so we hide them */
    margin: 0px 0 0px 0;
}

/* 2. Scroll Bar Handle (The movable thumb) */
QScrollBar::handle:vertical {
    /* Color and rounded edges for the thumb */
    background: #555555; /* Dark gray color */
    min-height: 20px;
    border-radius: 4px; /* Slightly rounded edges */
}

/* 3. Handle Hover State */
QScrollBar::handle:vertical:hover {
    background: #888888; /* Slightly lighter gray on hover */
}

/* 4. Scroll Bar Track (The background area behind the thumb) */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 5. Hiding the Arrows (If they appear) */
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    border: none;
    width: 0px;
    height: 0px;
    background: none;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}</string>
                 </property>
                 <property name="verticalScrollBarPolicy">
                  <enum>Qt::ScrollBarAsNeeded</enum>
                 </property>
                 <property name="sizeAdjustPolicy">
                  <enum>QAbstractScrollArea::AdjustIgnored</enum>
                 </property>
                 <property name="widgetResizable">
                  <bool>true</bool>
                 </property>
