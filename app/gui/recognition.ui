             <property name="styleSheet">
              <string notr="true">QCheckBox {
    spacing: 5px;
}

QCheckBox::indicator {
    width: 40px;
    height: 20px;
    border-radius: 10px; /* Makes it round (half of height) */
}

/* The OFF state (Gray) */
QCheckBox::indicator:unchecked {
    background-color: #555555;
    border: 2px solid #555555;
    /* To add a circle knob, you usually need an image here, 
       but we can simulate the &quot;track&quot; look with colors */
}

/* The ON state (Green/Blue) */
QCheckBox::indicator:checked {
    background-color: #00b894; /* Green color */
    border: 2px solid #00b894;
}</string>
